# Copy to `.env` (git-ignored) and fill in. NEVER commit `.env` or paste a key anywhere else.

# --- Database (PostgreSQL 15+) ---
# Local zero-install option: `pnpm db:start` runs an embedded PostgreSQL on this URL.
DATABASE_URL=postgres://counterbill:counterbill@127.0.0.1:54329/counterbill

# --- Model: Google Gemini, free tier (the configuration this project was run with) ---
# 1. Create a key at https://aistudio.google.com/apikey (no billing needed for the free tier).
# 2. Put it on the next line, in this file only, as an UPPER-CASE name with no quotes. Restart `pnpm dev` afterwards:
#    the worker process reads it at start.
GEMINI_API_KEY=

# A model that Mozaik 4.2.0 supports AND that your free tier serves. For the author's key:
#   gemini-3.5-flash-lite  works, fast (default)
#   gemini-3.5-flash       works, slower
#   gemini-3.8-flash       slow (91 s) and intermittently HTTP 503 -> avoid
#   gemini-3.1-pro-preview NO free-tier quota (HTTP 429)  -> do not use on the free tier
# Free-tier access differs per account: check yours with `pnpm gemini:models`.
MOZAIK_MODEL=gemini-3.5-flash-lite
# Gemini thinking level (minimal | low | medium | high). Default "low".
# MOZAIK_REASONING_EFFORT=low

# --- Free-tier limits: bounded retries, pacing, clear errors (never a silent fallback to another model) ---
# Client-side pacing so a free key is not hammered. Loops still run concurrently; calls beyond this wait their turn. 0 = off.
MODEL_REQUESTS_PER_MINUTE=10
# On HTTP 429/5xx: retry up to this many times, waiting the delay the provider asks for...
MODEL_MAX_RETRIES=3
# ...but never longer than this per wait. A longer retryDelay (e.g. a daily quota) is reported as "quota exhausted".
MODEL_MAX_WAIT_SECONDS=75
# Attempts per agent task when the model's output fails validation (the reasons are fed back each time).
MAX_TASK_ATTEMPTS=3

# Other Mozaik providers are supported by the same code; set only the one that matches MOZAIK_MODEL.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Explicit, labelled deterministic mode for CI/offline checks. Never used implicitly. Leave unset for real runs.
# COUNTERBILL_INFERENCE=test

# --- App ---
PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
MAX_CASE_DOCUMENTS=10
MAX_FILE_MB=15
MAX_CASE_MB=50
MAX_AGENT_REVISIONS=4
MAX_MODEL_CALLS_PER_RUN=40
AGENT_TASK_TIMEOUT_MS=300000
DEMO_RUNS_PER_IP_PER_HOUR=6
