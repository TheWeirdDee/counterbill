# --- Database (PostgreSQL 15+) ---
# Local zero-install option: `pnpm db:start` runs an embedded PostgreSQL on this URL.
DATABASE_URL=postgres://counterbill:counterbill@127.0.0.1:54329/counterbill

# --- Model provider (Mozaik picks the provider from MOZAIK_MODEL) ---
# Set ONE key that matches the model. Live investigations are impossible without it.
MOZAIK_MODEL=gpt-5.5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Explicit, labelled deterministic mode for CI/offline checks. Never used implicitly.
# COUNTERBILL_INFERENCE=test

# --- App ---
PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
MAX_CASE_DOCUMENTS=10
MAX_FILE_MB=15
MAX_CASE_MB=50
MAX_AGENT_REVISIONS=4
MAX_MODEL_CALLS_PER_RUN=24
AGENT_TASK_TIMEOUT_MS=180000
DEMO_RUNS_PER_IP_PER_HOUR=6
# Optional: set to a dir to also keep a local copy of uploads (dev only). Default storage is PostgreSQL.
# STORAGE_DRIVER=db
